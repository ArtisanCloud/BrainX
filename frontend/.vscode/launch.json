{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "npm run dev",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "npm", // 使用 npm 执行
      "runtimeArgs": ["run", "dev"], // 传递 npm 命令和参数
      "cwd": "${workspaceFolder}", // 工作目录，默认为当前项目根目录
      "console": "integratedTerminal" // 在集成终端中运行
    },
    {
      "type": "node",
      "request": "launch",
      "name": "npm run start",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "npm", // 使用 npm 执行
      "runtimeArgs": ["run", "start"], // 传递 npm 命令和参数
      "cwd": "${workspaceFolder}", // 工作目录，默认为当前项目根目录
      "console": "integratedTerminal" // 在集成终端中运行
    },
    {
      "type": "node",
      "request": "launch",
      "name": "npm run build",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "npm", // 使用 npm 执行
      "runtimeArgs": ["run", "build"], // 传递 npm 命令和参数
      "cwd": "${workspaceFolder}", // 工作目录，默认为当前项目根目录
      "console": "integratedTerminal" // 在集成终端中运行
    }
  ]
}
